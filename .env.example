# --- Database ---
DATABASE_URL=postgresql+asyncpg://skillbridge:skillbridge@localhost:5432/skillbridge
# Synchronous URL used by Alembic
DATABASE_URL_SYNC=postgresql+psycopg://skillbridge:skillbridge@localhost:5432/skillbridge

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# --- AI ---
# Provider: "mock" (no network, deterministic), "openai", or "anthropic"
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60

# Embeddings (optional; requires sentence-transformers)
EMBEDDINGS_ENABLED=false
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MATCH_THRESHOLD=0.82

# --- Storage ---
# "local" writes to ./uploads (dev); "s3" uses any S3-compatible endpoint
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./uploads
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# --- App ---
APP_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
MAX_RESUME_BYTES=5242880
MAX_RESUME_PAGES=5
